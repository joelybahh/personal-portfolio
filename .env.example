# --- Supabase (optional) ---
# When these are set, project content is pulled from the Supabase `projects`
# table (with ISR). When absent, the site falls back to the markdown files in
# /content/projects, so local dev and previews work with zero setup.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, used by `npm run seed` to push markdown into Supabase.
# NEVER expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=
